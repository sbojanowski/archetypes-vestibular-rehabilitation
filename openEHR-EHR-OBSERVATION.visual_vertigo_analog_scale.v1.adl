                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0163] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
