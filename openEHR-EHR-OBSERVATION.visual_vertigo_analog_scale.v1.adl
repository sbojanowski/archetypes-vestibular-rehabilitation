archetype (adl_version=1.4; uid=3a7f1c2d-5e9b-4f0a-b234-1e6d7a8c9b0e)
    openEHR-EHR-OBSERVATION.visual_vertigo_analog_scale.v1

concept
    [at0000]

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"]         = <"openEHR Modeller">
        ["date"]         = <"2026-06-16">
        ["organisation"] = <"">
        ["email"]        = <"">
    >
    details = <
        ["en"] = <
            language    = <[ISO_639-1::en]>
            purpose     = <"To record the results of the Visual Vertigo Analog Scale (VVAS), a nine-item self-report instrument that quantifies the severity of visually induced dizziness or disorientation provoked by specific visual environments and motion stimuli.">
            use         = <"Use to record VVAS responses in patients presenting with visual vertigo, visually induced dizziness, or vestibular dysfunction with visual dependency. The respondent indicates the amount of dizziness experienced in each of nine situations by marking a 10 cm horizontal visual analog scale (VAS) anchored at 0 (no dizziness) and 10 (the most dizziness). For each item, record whether it was completed, the VAS score (0–10, measured as the position of the mark from the left anchor) and an optional comment. The total score is the mean of the completed item scores multiplied by 10, giving a value between 0 and 100. Administer before and after vestibular rehabilitation to monitor treatment response.">
            misuse      = <"Not intended for children under 12 years without specific validation. Not a diagnostic tool; use as part of a comprehensive vestibular and neuro-otological assessment. Do not use as a substitute for the Dizziness Handicap Inventory (DHI); the two scales measure complementary but distinct constructs.">
            copyright   = <"© Dannenbaum E, Chilingaryan G, Fung J. Visual vertigo analogue scale: an assessment questionnaire for visual vertigo. Journal of Vestibular Research. 2011;21(3):153-159. Reproduced under license from IOS Press.">
            keywords    = <"visual vertigo","visually induced dizziness","vestibular","VAS","VVAS","visual dependency","motion sickness","balance">
        >
    >
    lifecycle_state = <"in_development">
    other_details = <
        ["licence"]                = <"Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)">
        ["custodian_organisation"] = <"openEHR Foundation">
        ["references"]             = <"Dannenbaum E, Chilingaryan G, Fung J. Visual vertigo analogue scale: an assessment questionnaire for visual vertigo. J Vestib Res. 2011;21(3):153-159. doi:10.3233/VES-2011-0412.
Longridge NS, et al. 2002 (original visual vertigo situations from which the VVAS was adapted).
Dannenbaum E, Paquet N, Hakim-Zadeh R, Feldman AG. Optimal parameters for the treatment of benign paroxysmal positional vertigo using the canalith repositioning procedure. J Otolaryngol. 2005;34(5):342-347.">
        ["original_namespace"]     = <"org.openehr">
        ["MD5-CAM-1.0.1"]          = <"">
    >

definition
    OBSERVATION[at0000] matches {                        -- Visual Vertigo Analog Scale (VVAS)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    POINT_EVENT[at0002] occurrences matches {0..1} matches {   -- Any point in time event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {

                                    -- =====================================================
                                    -- ITEM 1: Walking through a supermarket aisle
                                    -- =====================================================
                                    CLUSTER[at0010] occurrences matches {0..1} matches {   -- Item 1: Walking through a supermarket aisle
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0110] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0112] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0113] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- ITEM 2: Being a passenger in a car
                                    -- =====================================================
                                    CLUSTER[at0011] occurrences matches {0..1} matches {   -- Item 2: Being a passenger in a car
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0120] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0122] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0123] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- ITEM 3: Being under fluorescent lights
                                    -- =====================================================
                                    CLUSTER[at0012] occurrences matches {0..1} matches {   -- Item 3: Being under fluorescent lights
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0130] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0132] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0133] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- ITEM 4: Watching traffic at a busy intersection
                                    -- =====================================================
                                    CLUSTER[at0013] occurrences matches {0..1} matches {   -- Item 4: Watching traffic at a busy intersection
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0140] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0142] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0143] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- ITEM 5: Walking through a shopping mall
                                    -- =====================================================
                                    CLUSTER[at0014] occurrences matches {0..1} matches {   -- Item 5: Walking through a shopping mall
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0150] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0152] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0153] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
