                >
                ["at0190"] = <
                    text        = <"Assessment status">
                    description = <"Whether item 'Watching action television' was completed by the respondent.">
                >
                ["at0192"] = <
                    text        = <"VAS score">
                    description = <"Amount of dizziness experienced when watching action television. Rated by marking a 10 cm line anchored at 0 (no dizziness) and 10 (the most dizziness).">
                >
                ["at0193"] = <
                    text        = <"Comment">
                    description = <"Additional narrative about item 'Watching action television' not captured in other fields.">
                >
                ["at0101"] = <
                    text        = <"Performed">
                    description = <"The item was rated by the respondent.">
                >
                ["at0102"] = <
                    text        = <"Not performed">
                    description = <"The item was not rated, e.g. because the situation is not applicable to the respondent.">
                >
                ["at0103"] = <
                    text        = <"Partially performed">
                    description = <"The item was only partially completed, e.g. the mark on the scale was ambiguous or the respondent was unsure.">
                >

                -- ---- Scores ----
                ["at0050"] = <
                    text        = <"Total VVAS score">
                    description = <"Arithmetic mean of the completed item scores (each 0–10), multiplied by 10. If one or more items are not applicable, the mean is calculated from the completed items only. Range 0–100. Higher scores indicate greater visually induced dizziness severity.">
                >
                ["at0051"] = <
                    text        = <"Number of items completed">
                    description = <"Count of VVAS items actually rated by the respondent (1–9). Items that are not applicable to the patient (e.g., item 7 for a patient who never goes to the movie theatre) may be omitted; the total score is then derived from completed items only.">
                >

                -- ---- Symptom qualifiers ----
                ["at0060"] = <
                    text        = <"Symptom qualifiers">
                    description = <"Optional cluster to record the predominant symptom type experienced across the VVAS situations.">
                >
                ["at0061"] = <
                    text        = <"Predominant symptom">
                    description = <"The symptom type most prominently reported by the patient when rating VVAS items.">
                >
                ["at0062"] = <
                    text        = <"Dizziness">
                    description = <"Predominant symptom is dizziness (a non-specific sensation of disturbed or impaired spatial orientation).">
                >
                ["at0063"] = <
                    text        = <"Disorientation">
                    description = <"Predominant symptom is spatial disorientation or confusion about body position relative to the environment.">
                >
                ["at0064"] = <
                    text        = <"Nausea">
                    description = <"Predominant symptom is nausea or queasiness provoked by visual stimuli.">
                >
                ["at0065"] = <
                    text        = <"Unsteadiness">
                    description = <"Predominant symptom is unsteadiness or imbalance provoked by visual stimuli.">
                >
                ["at0066"] = <
                    text        = <"Other">
                    description = <"Predominant symptom is other than those listed; specify in comment field.">
                >
                ["at0067"] = <
                    text        = <"Symptom qualifier comment">
                    description = <"Additional narrative description of the predominant symptom or any other symptom qualifiers.">
                >

                ["at0070"] = <
                    text        = <"Comment">
                    description = <"Additional narrative about the VVAS assessment not captured in other fields.">
                >

                -- ---- State ----
                ["at0071"] = <
                    text        = <"Confounding factors">
                    description = <"Narrative description of any factors that may have influenced the patient's VVAS ratings, such as concurrent medications (e.g., vestibular suppressants), recent vestibular event, or situational anxiety.">
                >

                -- ---- Protocol ----
                ["at0080"] = <
                    text        = <"Administration method">
                    description = <"Method by which the VVAS was administered.">
                >
                ["at0081"] = <
                    text        = <"Self-administered (paper)">
                    description = <"Patient completed the questionnaire independently using a printed 10 cm VAS form.">
                >
                ["at0082"] = <
                    text        = <"Self-administered (electronic)">
                    description = <"Patient completed the questionnaire independently via an electronic device (tablet, computer, or smartphone).">
                >
                ["at0083"] = <
                    text        = <"Clinician-administered (interview)">
                    description = <"A clinician read each item to the patient and recorded the VAS response.">
                >
                ["at0084"] = <
                    text        = <"Proxy-reported">
                    description = <"A proxy (e.g., carer or family member) completed the questionnaire on behalf of the patient.">
                >
                ["at0085"] = <
                    text        = <"Scale format">
                    description = <"The format of the rating scale used for each item.">
                >
                ["at0086"] = <
                    text        = <"10 cm visual analog scale (pen and paper)">
                    description = <"Patient marked a position on a printed 10 cm horizontal line anchored at 0 (no dizziness) and 10 (the most dizziness); score derived by measuring the distance from the left anchor in cm.">
                >
                ["at0087"] = <
                    text        = <"Numeric rating scale 0–10 (digital)">
                    description = <"Patient entered or selected a value from 0 to 10 on a digital interface; functionally equivalent to the VAS.">
                >
                ["at0088"] = <
                    text        = <"Questionnaire language">
                    description = <"Language in which the VVAS was administered; relevant when a validated translation is used.">
                >
                ["at0089"] = <
                    text        = <"Version">
                    description = <"Specific version or adaptation of the VVAS used (e.g., 'Dannenbaum et al. 2011, adapted from Longridge et al. 2002', 'Swedish adaptation 2015').">
                >
                ["at0090"] = <
                    text        = <"Extension">
                    description = <"Additional information required to capture local content or to align with other reference models or formalisms.">
                >

            >
        >
    >
