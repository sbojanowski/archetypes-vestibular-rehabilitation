                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- ITEM 7: Watching a movie at the movie theatre
                                    -- =====================================================
                                    CLUSTER[at0016] occurrences matches {0..1} matches {   -- Item 7: Watching a movie at the movie theatre
                                        items cardinality matches {1..*; unordered} matches {
