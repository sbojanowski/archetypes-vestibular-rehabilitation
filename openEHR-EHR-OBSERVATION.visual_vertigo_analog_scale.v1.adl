                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0172] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0173] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- ITEM 8: Walking over a patterned floor
                                    -- =====================================================
                                    CLUSTER[at0017] occurrences matches {0..1} matches {   -- Item 8: Walking over a patterned floor
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0180] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0182] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0183] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- ITEM 9: Watching action television
                                    -- =====================================================
                                    CLUSTER[at0018] occurrences matches {0..1} matches {   -- Item 9: Watching action television
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0190] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0192] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0193] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- TOTAL SCORE
                                    -- =====================================================
                                    ELEMENT[at0050] occurrences matches {0..1} matches {   -- Total VVAS score
                                        value matches {
                                            DV_QUANTITY matches {
                                                property matches {[openehr::380]}
                                                units matches {"1"}
                                                magnitude matches {|0.0..100.0|}
                                                precision matches {|1|}
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- NUMBER OF ITEMS COMPLETED
                                    -- =====================================================
                                    ELEMENT[at0051] occurrences matches {0..1} matches {   -- Number of items completed
                                        value matches {
                                            DV_COUNT matches {
                                                magnitude matches {|1..9|}
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- SYMPTOM TYPE PER ITEM (optional qualifier)
                                    -- =====================================================
                                    CLUSTER[at0060] occurrences matches {0..1} matches {   -- Symptom qualifiers
                                        items cardinality matches {1..*; unordered} matches {

                                            ELEMENT[at0061] occurrences matches {0..1} matches {   -- Predominant symptom
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0062,    -- Dizziness
                                                            at0063,    -- Disorientation
                                                            at0064,    -- Nausea
                                                            at0065,    -- Unsteadiness
                                                            at0066]    -- Other
                                                        }
                                                    }
                                                }
                                            }

                                            ELEMENT[at0067] occurrences matches {0..1} matches {   -- Symptom qualifier comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }

                                        }
                                    }

                                    ELEMENT[at0070] occurrences matches {0..1} matches {   -- Comment
                                        value matches {
                                            DV_TEXT matches {*}
                                        }
                                    }

                                }
                            }
                        }
                        state matches {
                            ITEM_TREE[at0004] matches {
                                items cardinality matches {0..*; unordered} matches {

                                    ELEMENT[at0071] occurrences matches {0..1} matches {   -- Confounding factors
                                        value matches {
                                            DV_TEXT matches {*}
                                        }
                                    }

                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0005] matches {
                items cardinality matches {0..*; unordered} matches {

                    ELEMENT[at0080] occurrences matches {0..1} matches {   -- Administration method
                        value matches {
                            DV_CODED_TEXT matches {
                                defining_code matches {
                                    [local::
                                    at0081,   -- Self-administered (paper)
                                    at0082,   -- Self-administered (electronic)
                                    at0083,   -- Clinician-administered (interview)
                                    at0084]   -- Proxy-reported
                                }
                            }
                        }
                    }

                    ELEMENT[at0085] occurrences matches {0..1} matches {   -- Scale format
                        value matches {
                            DV_CODED_TEXT matches {
                                defining_code matches {
                                    [local::
                                    at0086,   -- 10 cm visual analog scale (pen and paper)
                                    at0087]   -- Numeric rating scale 0–10 (digital)
                                }
                            }
                        }
                    }

                    ELEMENT[at0088] occurrences matches {0..1} matches {   -- Questionnaire language
                        value matches {
                            DV_TEXT matches {*}
                        }
                    }

                    ELEMENT[at0089] occurrences matches {0..1} matches {   -- Version
                        value matches {
                            DV_TEXT matches {*}
                        }
                    }

                    allow_archetype CLUSTER[at0090] occurrences matches {0..*} matches {   -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }

                }
            }
        }
    }

ontology
    term_definitions = <
        ["en"] = <
            items = <

                -- ---- Archetype root ----
                ["at0000"] = <
                    text        = <"Visual Vertigo Analog Scale (VVAS)">
                    description = <"A nine-item self-report questionnaire that quantifies the severity of visually induced dizziness or disorientation provoked by specific visual environments. Each item is scored on a 10 cm visual analog scale (0 = no dizziness, 10 = the most dizziness). The total VVAS score is the mean of completed item scores multiplied by 10 (range 0–100).">
                >
                ["at0001"] = <
                    text        = <"History">
                    description = <"Event series in the OBSERVATION.">
                >
                ["at0002"] = <
                    text        = <"Any point in time event">
                    description = <"Default, unspecified point in time event which may be more explicitly defined in a template or at run-time.">
                >
                ["at0003"] = <
                    text        = <"Item tree">
                    description = <"@ internal @">
                >
                ["at0004"] = <
                    text        = <"Item tree">
                    description = <"@ internal @">
                >
                ["at0005"] = <
                    text        = <"Item tree">
                    description = <"@ internal @">
                >

                -- ---- Items ----
                ["at0010"] = <
                    text        = <"Item 1: Walking through a supermarket aisle">
                    description = <"VVAS item for the situation 'Walking through a supermarket aisle'.">
                >
                ["at0110"] = <
                    text        = <"Assessment status">
                    description = <"Whether item 'Walking through a supermarket aisle' was completed by the respondent.">
                >
                ["at0112"] = <
                    text        = <"VAS score">
                    description = <"Amount of dizziness experienced when walking through a supermarket aisle. Rated by marking a 10 cm line anchored at 0 (no dizziness) and 10 (the most dizziness).">
                >
                ["at0113"] = <
                    text        = <"Comment">
                    description = <"Additional narrative about item 'Walking through a supermarket aisle' not captured in other fields.">
                >
                ["at0011"] = <
