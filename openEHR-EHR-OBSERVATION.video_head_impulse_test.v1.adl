                        value matches {
                            DV_CODED_TEXT matches {
                                defining_code matches {
                                    [local::
                                    at0941,    -- Instantaneous gain at 40 ms
                                    at0942,    -- Instantaneous gain at 60 ms
                                    at0943,    -- Instantaneous gain at 80 ms
                                    at0944,    -- Regression gain
                                    at0945,    -- Area under the curve ratio
                                    at0946]    -- Other
                                }
                            }
                        }
                    }

                    ELEMENT[at0074] occurrences matches {0..1} matches {   -- Target distance
                        value matches {
                            DV_QUANTITY matches {
                                property matches {[openehr::122]}
                                units matches {"cm"}
                                magnitude matches {|0.0..1000.0|}
                                precision matches {|0|}
                            }
                        }
                    }

                    allow_archetype CLUSTER[at0075] occurrences matches {0..*} matches {   -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }

                }
            }
        }
    }

ontology
    term_definitions = <
        ["en"] = <
            items = <
                ["at0000"] = <
                    text        = <"Video Head Impulse Test (vHIT)">
                    description = <"Results of a video head impulse test (vHIT): a quantitative assessment of the vestibulo-ocular reflex (VOR) for each semicircular canal, using brief, rapid, passive head impulses and high-speed video-oculography.">
                >
                ["at0001"] = <
                    text        = <"History">
                    description = <"Event series in the OBSERVATION.">
                >
                ["at0002"] = <
                    text        = <"Any point in time event">
                    description = <"Default, unspecified point in time event which may be more explicitly defined in a template or at run-time.">
                >
                ["at0003"] = <
                    text        = <"Item tree">
                    description = <"@ internal @">
                >
                ["at0004"] = <
                    text        = <"Item tree">
                    description = <"@ internal @">
                >
                ["at0005"] = <
                    text        = <"Item tree">
                    description = <"@ internal @">
                >
                ["at0050"] = <
                    text        = <"Overall interpretation">
                    description = <"Narrative clinical interpretation of the vHIT examination as a whole, e.g. which canals show reduced function.">
                >
                ["at0051"] = <
                    text        = <"Comment">
                    description = <"Additional narrative about the vHIT examination not captured in other fields.">
                >
                ["at0052"] = <
                    text        = <"Multimedia representation">
                    description = <"Recorded eye and head velocity traces or reports exported from the vHIT device.">
                >
                ["at0060"] = <
                    text        = <"Confounding factors">
                    description = <"Factors that may have affected the results, e.g. neck stiffness, eyelid closure, glasses or contact lenses, medication, fatigue or poor cooperation.">
                >
                ["at0070"] = <
                    text        = <"Device">
                    description = <"Manufacturer and model of the vHIT system.">
                >
                ["at0071"] = <
                    text        = <"Software version">
                    description = <"Version of the vHIT analysis software.">
                >
                ["at0072"] = <
                    text        = <"Recorded eye">
                    description = <"Eye or eyes from which eye movements were recorded.">
                >
                ["at0073"] = <
                    text        = <"Gain calculation method">
                    description = <"Method used to calculate the VOR gain.">
                >
                ["at0074"] = <
                    text        = <"Target distance">
                    description = <"Distance between the patient's eyes and the fixation target.">
                >
                ["at0075"] = <
                    text        = <"Extension">
                    description = <"Additional information required to capture local content or to align with other reference models or formalisms.">
                >
                ["at0100"] = <
                    text        = <"Lateral canals">
                    description = <"Head impulse paradigm (HIMP) testing in the horizontal plane, stimulating the left and right lateral (horizontal) semicircular canals.">
                >
                ["at0101"] = <
                    text        = <"Test status">
                    description = <"Whether the Lateral canals test was performed.">
                >
                ["at0102"] = <
                    text        = <"Gain asymmetry">
                    description = <"Asymmetry between left and right lateral canal VOR gains: |left − right| / (left + right) × 100.">
                >
                ["at0103"] = <
                    text        = <"Comment">
                    description = <"Additional narrative about the Lateral canals test.">
                >
                ["at0110"] = <
                    text        = <"Left lateral canal">
                    description = <"Head impulse paradigm (HIMP) results for impulses stimulating the left lateral semicircular canal.">
                >
                ["at0111"] = <
                    text        = <"VOR gain">
                    description = <"Mean vestibulo-ocular reflex gain (eye velocity / head velocity) for impulses stimulating the left lateral semicircular canal, calculated by the method recorded in the protocol.">
                >
                ["at0112"] = <
                    text        = <"Number of valid impulses">
                    description = <"Number of impulses towards the left lateral semicircular canal accepted for analysis.">
                >
                ["at0113"] = <
                    text        = <"Mean peak head velocity">
                    description = <"Mean peak head velocity of the accepted impulses stimulating the left lateral semicircular canal.">
                >
                ["at0114"] = <
                    text        = <"Covert saccades">
                    description = <"Whether covert (catch-up) saccades occurring during the head impulse were observed for the left lateral semicircular canal.">
                >
                ["at0115"] = <
                    text        = <"Overt saccades">
                    description = <"Whether overt (catch-up) saccades occurring after the head impulse were observed for the left lateral semicircular canal.">
                >
                ["at0116"] = <
                    text        = <"Mean saccade latency">
                    description = <"Mean latency from impulse onset to the first catch-up saccade for the left lateral semicircular canal.">
                >
                ["at0117"] = <
                    text        = <"Mean saccade peak velocity">
                    description = <"Mean peak velocity of the catch-up saccades for the left lateral semicircular canal.">
                >
                ["at0118"] = <
                    text        = <"PR score">
                    description = <"Saccade grouping (synchrony) score for the left lateral semicircular canal, as reported by the device software. 0 indicates scattered saccade latencies and 100 tightly grouped latencies.">
                >
                ["at0119"] = <
                    text        = <"Interpretation">
                    description = <"Clinical interpretation of the result for the left lateral semicircular canal.">
                >
                ["at0120"] = <
                    text        = <"Comment">
                    description = <"Additional narrative about the result for the left lateral semicircular canal.">
