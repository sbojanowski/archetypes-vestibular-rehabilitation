archetype (adl_version=1.4; uid=20130ca3-7317-4453-ab89-943d86252bd3)
    openEHR-EHR-OBSERVATION.video_head_impulse_test.v1

concept
    [at0000]

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"]         = <"openEHR Modeller">
        ["date"]         = <"2026-11-11">
        ["organisation"] = <"">
        ["email"]        = <"">
    >
    details = <
        ["en"] = <
            language    = <[ISO_639-1::en]>
            purpose     = <"To record the outcome of a video head impulse test (vHIT) examination, covering head impulse paradigm (HIMP) testing of the lateral canals and of the LARP and RALP vertical canal planes, and suppression head impulse paradigm (SHIMP) testing.">
            use         = <"Use to record vHIT results for each tested semicircular canal: VOR gain, number of valid impulses, mean peak head velocity, presence and characteristics of catch-up saccades, and the clinical interpretation. Results are grouped by test: lateral canals, LARP plane (left anterior and right posterior canals) and RALP plane (right anterior and left posterior canals) using the head impulse paradigm (HIMP), and SHIMP for the lateral canals. Each test records whether it was performed and the gain asymmetry between the two canals tested. The gain calculation method, device and recorded eye are recorded in the protocol, because gain values from different methods and devices are not directly comparable. Recorded traces may be attached using the Multimedia representation slot.">
            misuse      = <"Not to be used for the bedside (clinical) head impulse test without video-oculography; record that with an examination archetype. Not intended to record caloric, rotational chair or VEMP test results.">
            copyright   = <"">
            keywords    = <"vHIT","video head impulse test","head impulse test","HIT","HIMP","SHIMP","VOR","vestibulo-ocular reflex","VOR gain","semicircular canal","LARP","RALP","catch-up saccades","covert saccades","overt saccades","vestibular">
        >
    >
    lifecycle_state = <"in_development">
    other_details = <
        ["licence"]                = <"Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)">
        ["custodian_organisation"] = <"openEHR Foundation">
        ["references"]             = <"Halmagyi GM, Curthoys IS. A clinical sign of canal paresis. Arch Neurol. 1988;45(7):737-739.
MacDougall HG, Weber KP, McGarvie LA, Halmagyi GM, Curthoys IS. The video head impulse test: diagnostic accuracy in peripheral vestibulopathy. Neurology. 2009;73(14):1134-1141.
MacDougall HG, McGarvie LA, Halmagyi GM, Rogers SJ, Manzari L, Burgess AM, Curthoys IS, Weber KP. A new saccadic indicator of peripheral vestibular function based on the video head impulse test. Neurology. 2016;87(4):410-418.">
        ["original_namespace"]     = <"org.openehr">
        ["MD5-CAM-1.0.1"]          = <"">
    >

definition
    OBSERVATION[at0000] matches {                        -- Video Head Impulse Test (vHIT)
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    POINT_EVENT[at0002] occurrences matches {0..1} matches {   -- Any point in time event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {

                                CLUSTER[at0100] occurrences matches {0..1} matches {   -- Lateral canals
                                    items cardinality matches {1..*; unordered} matches {
                                        ELEMENT[at0101] occurrences matches {0..1} matches {   -- Test status
                                            value matches {
                                                DV_CODED_TEXT matches {
                                                    defining_code matches {
                                                        [local::
                                                        at0901,    -- Performed
                                                        at0902,    -- Not performed
                                                        at0903]    -- Partially performed
                                                    }
                                                }
                                            }
                                        }
                                        CLUSTER[at0110] occurrences matches {0..1} matches {   -- Left lateral canal
                                            items cardinality matches {1..*; unordered} matches {
                                                ELEMENT[at0111] occurrences matches {0..1} matches {   -- VOR gain
                                                    value matches {
                                                        DV_QUANTITY matches {
                                                            property matches {[openehr::380]}
                                                            units matches {"1"}
                                                            magnitude matches {|0.0..3.0|}
                                                            precision matches {|2|}
                                                        }
                                                    }
                                                }
                                                ELEMENT[at0112] occurrences matches {0..1} matches {   -- Number of valid impulses
                                                    value matches {
                                                        DV_COUNT matches {
                                                            magnitude matches {|>=0|}
                                                        }
                                                    }
                                                }
                                                ELEMENT[at0113] occurrences matches {0..1} matches {   -- Mean peak head velocity
                                                    value matches {
                                                        DV_QUANTITY matches {
                                                            property matches {[openehr::380]}
                                                            units matches {"deg/s"}
                                                            magnitude matches {|0.0..1000.0|}
                                                            precision matches {|0|}
                                                        }
                                                    }
                                                }
                                                ELEMENT[at0114] occurrences matches {0..1} matches {   -- Covert saccades
                                                    value matches {
                                                        DV_CODED_TEXT matches {
                                                            defining_code matches {
                                                                [local::
                                                                at0911,    -- Present
                                                                at0912]    -- Absent
                                                            }
                                                        }
                                                    }
                                                }
                                                ELEMENT[at0115] occurrences matches {0..1} matches {   -- Overt saccades
