archetype (adl_version=1.4; uid=d401a7ba-3c1f-4d4d-ab51-8398f63ce40f)
    openEHR-EHR-OBSERVATION.crowd_vr_assessment.v1

concept
    [at0000]

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"]         = <"openEHR Modeller">
        ["date"]         = <"2026-11-11">
        ["organisation"] = <"">
        ["email"]        = <"">
    >
    details = <
        ["en"] = <
            language    = <[ISO_639-1::en]>
            purpose     = <"To record the results of a CrowdVR assessment performed using the Virtualis CrowdVR virtual reality application, in which the patient rates the intensity of symptoms provoked by exposure to crowded and visually busy everyday environments.">
            use         = <"Use to record the patient's symptom ratings for each of the six virtual environments presented by the Virtualis CrowdVR virtual reality application: shop, narrow corridor, shopping center ground floor, shopping center first floor, metro station and city intersection. For each environment, record whether it was performed, the symptom rating on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms), and an optional comment. Repeat the assessment over the course of vestibular rehabilitation to monitor change in symptoms provoked by crowded and visually complex environments.">
            misuse      = <"Not a diagnostic tool; use as part of a comprehensive vestibular assessment. Not intended to record results of assessments performed with other applications or environment sets, whose conditions are not equivalent.">
            copyright   = <"">
            keywords    = <"CrowdVR","crowd","visual vertigo","visually induced dizziness","virtual reality","Virtualis","VAS","vestibular rehabilitation">
        >
    >
    lifecycle_state = <"in_development">
    other_details = <
        ["licence"]                = <"Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)">
        ["custodian_organisation"] = <"openEHR Foundation">
        ["references"]             = <"">
        ["original_namespace"]     = <"org.openehr">
        ["MD5-CAM-1.0.1"]          = <"">
    >

definition
    OBSERVATION[at0000] matches {                        -- CrowdVR assessment
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    POINT_EVENT[at0002] occurrences matches {0..1} matches {   -- Any point in time event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {

                                    -- =====================================================
                                    -- ITEM 1: Shop environment
                                    -- =====================================================
                                    CLUSTER[at0010] occurrences matches {0..1} matches {   -- Shop environment
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0110] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0112] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0113] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- ITEM 2: Narrow corridor environment
                                    -- =====================================================
                                    CLUSTER[at0011] occurrences matches {0..1} matches {   -- Narrow corridor environment
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0120] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0122] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0123] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- ITEM 3: Shopping center ground floor environment
                                    -- =====================================================
                                    CLUSTER[at0012] occurrences matches {0..1} matches {   -- Shopping center ground floor environment
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0130] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0132] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0133] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- ITEM 4: Shopping center first floor environment
                                    -- =====================================================
                                    CLUSTER[at0013] occurrences matches {0..1} matches {   -- Shopping center first floor environment
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0140] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0142] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0143] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- ITEM 5: Metro station environment
                                    -- =====================================================
                                    CLUSTER[at0014] occurrences matches {0..1} matches {   -- Metro station environment
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0150] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0152] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0153] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
                                    -- ITEM 6: City intersection environment
                                    -- =====================================================
                                    CLUSTER[at0015] occurrences matches {0..1} matches {   -- City intersection environment
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0160] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0162] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0163] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    ELEMENT[at0070] occurrences matches {0..1} matches {   -- Comment
                                        value matches {
                                            DV_TEXT matches {*}
                                        }
                                    }

                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0005] matches {
                items cardinality matches {0..*; unordered} matches {

                    ELEMENT[at0080] occurrences matches {0..1} matches {   -- Application version
                        value matches {
                            DV_TEXT matches {*}
                        }
                    }

                    ELEMENT[at0081] occurrences matches {0..1} matches {   -- Virtual reality device
                        value matches {
                            DV_TEXT matches {*}
                        }
                    }

                    allow_archetype CLUSTER[at0090] occurrences matches {0..*} matches {   -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }

                }
            }
        }
    }

