                >
                ["at0003"] = <
                    text        = <"Item tree">
                    description = <"@ internal @">
                >
                ["at0005"] = <
                    text        = <"Item tree">
                    description = <"@ internal @">
                >

                -- ---- Items ----
                ["at0010"] = <
                    text        = <"Shop environment">
                    description = <"Assessment of symptoms provoked by exposure to a virtual shop in the Virtualis CrowdVR virtual reality application.">
                >
                ["at0110"] = <
                    text        = <"Assessment status">
                    description = <"Whether the 'Shop environment' was performed.">
                >
                ["at0112"] = <
                    text        = <"VAS score">
                    description = <"Patient-rated intensity of symptoms (e.g. dizziness, disorientation or discomfort) during the 'Shop environment', on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms).">
                >
                ["at0113"] = <
