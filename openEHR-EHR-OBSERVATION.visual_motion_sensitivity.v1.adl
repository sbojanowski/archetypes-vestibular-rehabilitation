archetype (adl_version=1.4; uid=beaf05dd-8ea1-4c40-af49-c79535600041)
    openEHR-EHR-OBSERVATION.visual_motion_sensitivity.v1

concept
    [at0000]

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"]         = <"openEHR Modeller">
        ["date"]         = <"2026-11-11">
        ["organisation"] = <"">
        ["email"]        = <"">
    >
    details = <
        ["en"] = <
            language    = <[ISO_639-1::en]>
            purpose     = <"To record the results of a Visual Motion Sensitivity assessment performed using the Virtualis Visual Motion Sensitivity virtual reality application, in which the patient rates the intensity of symptoms provoked by optokinetic and optical flow visual stimuli.">
            use         = <"Use to record the patient's symptom ratings for each of the eight visual stimulus conditions presented by the Virtualis Visual Motion Sensitivity virtual reality application: five optokinetic conditions (motionless, movement to the left, movement to the right, upward movement, downward movement) and three optical flow conditions (motionless, forward direction, backward direction). Each condition is rated on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms). Repeat the assessment over the course of vestibular rehabilitation to monitor change in visual motion sensitivity.">
            misuse      = <"Not a diagnostic tool; use as part of a comprehensive vestibular assessment. Not intended to record results of visual motion sensitivity assessments performed with other applications or stimulus sets, whose conditions are not equivalent.">
            copyright   = <"">
            keywords    = <"visual motion sensitivity","visual vertigo","optokinetic","optical flow","virtual reality","Virtualis","VAS","vestibular rehabilitation">
        >
    >
    lifecycle_state = <"in_development">
    other_details = <
        ["licence"]                = <"Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)">
        ["custodian_organisation"] = <"openEHR Foundation">
        ["references"]             = <"">
        ["original_namespace"]     = <"org.openehr">
        ["MD5-CAM-1.0.1"]          = <"">
    >

definition
    OBSERVATION[at0000] matches {                        -- Visual Motion Sensitivity
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    POINT_EVENT[at0002] occurrences matches {0..1} matches {   -- Any point in time event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {

                                    ELEMENT[at0010] occurrences matches {0..1} matches {   -- Optokinetic - motionless
                                        value matches {
                                            DV_QUANTITY matches {
                                                property matches {[openehr::380]}
                                                units matches {"1"}
                                                magnitude matches {|0.0..10.0|}
                                                precision matches {|1|}
                                            }
                                        }
                                    }

                                    ELEMENT[at0011] occurrences matches {0..1} matches {   -- Optokinetic - movement to the left
                                        value matches {
                                            DV_QUANTITY matches {
                                                property matches {[openehr::380]}
                                                units matches {"1"}
                                                magnitude matches {|0.0..10.0|}
                                                precision matches {|1|}
                                            }
                                        }
                                    }

                                    ELEMENT[at0012] occurrences matches {0..1} matches {   -- Optokinetic - movement to the right
                                        value matches {
                                            DV_QUANTITY matches {
                                                property matches {[openehr::380]}
                                                units matches {"1"}
                                                magnitude matches {|0.0..10.0|}
                                                precision matches {|1|}
                                            }
                                        }
                                    }

                                    ELEMENT[at0013] occurrences matches {0..1} matches {   -- Optokinetic - upward movement
                                        value matches {
                                            DV_QUANTITY matches {
                                                property matches {[openehr::380]}
                                                units matches {"1"}
                                                magnitude matches {|0.0..10.0|}
                                                precision matches {|1|}
                                            }
                                        }
                                    }

                                    ELEMENT[at0014] occurrences matches {0..1} matches {   -- Optokinetic - downward movement
                                        value matches {
                                            DV_QUANTITY matches {
                                                property matches {[openehr::380]}
                                                units matches {"1"}
                                                magnitude matches {|0.0..10.0|}
                                                precision matches {|1|}
                                            }
                                        }
                                    }

                                    ELEMENT[at0015] occurrences matches {0..1} matches {   -- Optical flow - motionless
                                        value matches {
                                            DV_QUANTITY matches {
                                                property matches {[openehr::380]}
                                                units matches {"1"}
                                                magnitude matches {|0.0..10.0|}
                                                precision matches {|1|}
                                            }
                                        }
                                    }

                                    ELEMENT[at0016] occurrences matches {0..1} matches {   -- Optical flow - forward direction
                                        value matches {
                                            DV_QUANTITY matches {
                                                property matches {[openehr::380]}
                                                units matches {"1"}
                                                magnitude matches {|0.0..10.0|}
                                                precision matches {|1|}
                                            }
                                        }
                                    }

                                    ELEMENT[at0017] occurrences matches {0..1} matches {   -- Optical flow - backward direction
                                        value matches {
                                            DV_QUANTITY matches {
                                                property matches {[openehr::380]}
                                                units matches {"1"}
                                                magnitude matches {|0.0..10.0|}
                                                precision matches {|1|}
                                            }
                                        }
                                    }

                                    ELEMENT[at0070] occurrences matches {0..1} matches {   -- Comment
                                        value matches {
                                            DV_TEXT matches {*}
                                        }
                                    }

                                }
                            }
                        }
                    }
                }
            }
        }
        protocol matches {
            ITEM_TREE[at0005] matches {
                items cardinality matches {0..*; unordered} matches {

                    ELEMENT[at0080] occurrences matches {0..1} matches {   -- Application version
                        value matches {
                            DV_TEXT matches {*}
                        }
                    }

                    ELEMENT[at0081] occurrences matches {0..1} matches {   -- Virtual reality device
                        value matches {
                            DV_TEXT matches {*}
                        }
                    }

                    allow_archetype CLUSTER[at0090] occurrences matches {0..*} matches {   -- Extension
                        include
                            archetype_id/value matches {/.*/}
                    }

                }
            }
        }
    }

ontology
    term_definitions = <
        ["en"] = <
            items = <

                -- ---- Archetype root ----
                ["at0000"] = <
                    text        = <"Visual Motion Sensitivity">
                    description = <"Patient-rated intensity of symptoms provoked by optokinetic and optical flow visual stimuli presented in the Virtualis Visual Motion Sensitivity virtual reality application.">
                >
                ["at0001"] = <
                    text        = <"History">
                    description = <"Event series in the OBSERVATION.">
                >
                ["at0002"] = <
                    text        = <"Any point in time event">
                    description = <"Default, unspecified point in time event which may be more explicitly defined in a template or at run-time.">
                >
                ["at0003"] = <
                    text        = <"Item tree">
                    description = <"@ internal @">
                >
                ["at0005"] = <
                    text        = <"Item tree">
                    description = <"@ internal @">
                >

                -- ---- Items ----
                ["at0010"] = <
                    text        = <"Optokinetic - motionless">
                    description = <"Patient-rated intensity of symptoms (e.g. dizziness, disorientation or discomfort) provoked by exposure to a stationary optokinetic stimulus (the optokinetic pattern displayed without movement) in the Virtualis Visual Motion Sensitivity virtual reality application. Rated on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms).">
                >
                ["at0011"] = <
                    text        = <"Optokinetic - movement to the left">
                    description = <"Patient-rated intensity of symptoms (e.g. dizziness, disorientation or discomfort) provoked by exposure to an optokinetic stimulus moving to the left in the Virtualis Visual Motion Sensitivity virtual reality application. Rated on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms).">
                >
                ["at0012"] = <
                    text        = <"Optokinetic - movement to the right">
                    description = <"Patient-rated intensity of symptoms (e.g. dizziness, disorientation or discomfort) provoked by exposure to an optokinetic stimulus moving to the right in the Virtualis Visual Motion Sensitivity virtual reality application. Rated on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms).">
                >
                ["at0013"] = <
                    text        = <"Optokinetic - upward movement">
                    description = <"Patient-rated intensity of symptoms (e.g. dizziness, disorientation or discomfort) provoked by exposure to an optokinetic stimulus moving upward in the Virtualis Visual Motion Sensitivity virtual reality application. Rated on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms).">
                >
                ["at0014"] = <
                    text        = <"Optokinetic - downward movement">
                    description = <"Patient-rated intensity of symptoms (e.g. dizziness, disorientation or discomfort) provoked by exposure to an optokinetic stimulus moving downward in the Virtualis Visual Motion Sensitivity virtual reality application. Rated on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms).">
                >
                ["at0015"] = <
                    text        = <"Optical flow - motionless">
                    description = <"Patient-rated intensity of symptoms (e.g. dizziness, disorientation or discomfort) provoked by exposure to a stationary optical flow scene (the scene displayed without movement) in the Virtualis Visual Motion Sensitivity virtual reality application. Rated on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms).">
                >
                ["at0016"] = <
                    text        = <"Optical flow - forward direction">
                    description = <"Patient-rated intensity of symptoms (e.g. dizziness, disorientation or discomfort) provoked by exposure to an optical flow stimulus simulating movement in the forward direction in the Virtualis Visual Motion Sensitivity virtual reality application. Rated on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms).">
                >
                ["at0017"] = <
                    text        = <"Optical flow - backward direction">
                    description = <"Patient-rated intensity of symptoms (e.g. dizziness, disorientation or discomfort) provoked by exposure to an optical flow stimulus simulating movement in the backward direction in the Virtualis Visual Motion Sensitivity virtual reality application. Rated on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms).">
                >

                ["at0070"] = <
                    text        = <"Comment">
                    description = <"Additional narrative about the Visual Motion Sensitivity assessment not captured in other fields.">
                >

                -- ---- Protocol ----
                ["at0080"] = <
                    text        = <"Application version">
                    description = <"Version of the Virtualis Visual Motion Sensitivity virtual reality application used for the assessment.">
                >
                ["at0081"] = <
                    text        = <"Virtual reality device">
                    description = <"Make and model of the virtual reality headset used to present the stimuli.">
                >
                ["at0090"] = <
                    text        = <"Extension">
                    description = <"Additional information required to capture local content or to align with other reference models or formalisms.">
                >

            >
        >
    >
