archetype (adl_version=1.4; uid=beaf05dd-8ea1-4c40-af49-c79535600041)
    openEHR-EHR-OBSERVATION.visual_motion_sensitivity.v1

concept
    [at0000]

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["name"]         = <"openEHR Modeller">
        ["date"]         = <"2026-11-11">
        ["organisation"] = <"">
        ["email"]        = <"">
    >
    details = <
        ["en"] = <
            language    = <[ISO_639-1::en]>
            purpose     = <"To record the results of a Visual Motion Sensitivity assessment performed using the Virtualis Visual Motion Sensitivity virtual reality application, in which the patient rates the intensity of symptoms provoked by optokinetic and optical flow visual stimuli.">
            use         = <"Use to record the patient's symptom ratings for each of the eight visual stimulus conditions presented by the Virtualis Visual Motion Sensitivity virtual reality application: five optokinetic conditions (motionless, movement to the left, movement to the right, upward movement, downward movement) and three optical flow conditions (motionless, forward direction, backward direction). For each condition, record whether it was performed (with the reason if it was not or only partially performed), the symptom rating on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms), and an optional comment. Repeat the assessment over the course of vestibular rehabilitation to monitor change in visual motion sensitivity.">
            misuse      = <"Not a diagnostic tool; use as part of a comprehensive vestibular assessment. Not intended to record results of visual motion sensitivity assessments performed with other applications or stimulus sets, whose conditions are not equivalent.">
            copyright   = <"">
            keywords    = <"visual motion sensitivity","visual vertigo","optokinetic","optical flow","virtual reality","Virtualis","VAS","vestibular rehabilitation">
        >
    >
    lifecycle_state = <"in_development">
    other_details = <
        ["licence"]                = <"Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0)">
        ["custodian_organisation"] = <"openEHR Foundation">
        ["references"]             = <"">
        ["original_namespace"]     = <"org.openehr">
        ["MD5-CAM-1.0.1"]          = <"">
    >

definition
    OBSERVATION[at0000] matches {                        -- Visual Motion Sensitivity
        data matches {
            HISTORY[at0001] matches {
                events cardinality matches {1..*; unordered} matches {
                    POINT_EVENT[at0002] occurrences matches {0..1} matches {   -- Any point in time event
                        data matches {
                            ITEM_TREE[at0003] matches {
                                items cardinality matches {0..*; unordered} matches {

                                    -- =====================================================
                                    -- ITEM 1: Optokinetic - motionless
                                    -- =====================================================
                                    CLUSTER[at0010] occurrences matches {0..1} matches {   -- Optokinetic - motionless
                                        items cardinality matches {1..*; unordered} matches {
                                            ELEMENT[at0110] occurrences matches {0..1} matches {   -- Assessment status
                                                value matches {
                                                    DV_CODED_TEXT matches {
                                                        defining_code matches {
                                                            [local::
                                                            at0101,    -- Performed
                                                            at0102,    -- Not performed
                                                            at0103]    -- Partially performed
                                                        }
                                                    }
                                                }
                                            }
                                            ELEMENT[at0111] occurrences matches {0..1} matches {   -- Reason not performed
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                            ELEMENT[at0112] occurrences matches {0..1} matches {   -- VAS score
                                                value matches {
                                                    DV_QUANTITY matches {
                                                        property matches {[openehr::380]}
                                                        units matches {"1"}
                                                        magnitude matches {|0.0..10.0|}
                                                        precision matches {|0..1|}
                                                    }
                                                }
                                            }
                                            ELEMENT[at0113] occurrences matches {0..1} matches {   -- Comment
                                                value matches {
                                                    DV_TEXT matches {*}
                                                }
                                            }
                                        }
                                    }

                                    -- =====================================================
