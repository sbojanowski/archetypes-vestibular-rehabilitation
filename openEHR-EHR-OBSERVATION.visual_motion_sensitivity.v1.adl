                    description = <"@ internal @">
                >

                -- ---- Items ----
                ["at0010"] = <
                    text        = <"Optokinetic - motionless">
                    description = <"Assessment of symptoms provoked by exposure to a stationary optokinetic stimulus (the optokinetic pattern displayed without movement) in the Virtualis Visual Motion Sensitivity virtual reality application.">
                >
                ["at0110"] = <
                    text        = <"Assessment status">
                    description = <"Whether the 'Optokinetic - motionless' condition was performed.">
                >
                ["at0111"] = <
                    text        = <"Reason not performed">
                    description = <"Reason the 'Optokinetic - motionless' condition was not performed or was only partially performed.">
                >
                ["at0112"] = <
                    text        = <"VAS score">
                    description = <"Patient-rated intensity of symptoms (e.g. dizziness, disorientation or discomfort) during the 'Optokinetic - motionless' condition, on a visual analog scale (VAS) from 0 (no symptoms) to 10 (the most severe symptoms).">
