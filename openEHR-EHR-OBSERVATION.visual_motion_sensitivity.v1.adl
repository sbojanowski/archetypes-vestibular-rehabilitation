    term_definitions = <
        ["en"] = <
            items = <

                -- ---- Archetype root ----
                ["at0000"] = <
                    text        = <"Visual Motion Sensitivity">
                    description = <"Patient-rated intensity of symptoms provoked by optokinetic and optical flow visual stimuli presented in the Virtualis Visual Motion Sensitivity virtual reality application.">
                >
                ["at0001"] = <
                    text        = <"History">
                    description = <"Event series in the OBSERVATION.">
